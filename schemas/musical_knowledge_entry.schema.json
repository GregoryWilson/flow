{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow.local/schemas/musical-knowledge-entry-v1.json",
  "title": "Flow musical knowledge entry",
  "type": "object",
  "required": ["schema_version", "id", "title", "status", "intent", "recipe"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["proposed", "reviewed", "demonstrated", "validated", "rejected", "superseded"]
    },
    "intent": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "effects": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "requires": { "type": "array", "items": { "type": "string" } },
        "avoid_when": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["roles", "events", "invariants", "transformations"],
      "properties": {
        "roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "focus_plan": {
          "type": "array",
          "description": "Optional time-varying foreground plan. A lead role is not required.",
          "items": {
            "type": "object",
            "required": ["start_beat", "duration_beats", "foreground_roles", "melody_presence"],
            "properties": {
              "start_beat": { "type": "number", "minimum": 0 },
              "duration_beats": { "type": "number", "exclusiveMinimum": 0 },
              "foreground_roles": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "melody_presence": {
                "enum": ["foreground", "background", "absent", "intermittent", "unknown"]
              }
            },
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "beat", "duration_beats", "event_type"],
            "properties": {
              "role": { "type": "string" },
              "beat": { "type": "number" },
              "duration_beats": { "type": "number", "exclusiveMinimum": 0 },
              "event_type": { "enum": ["note", "rest", "silence", "control"] },
              "scale_degree": { "type": ["number", "null"] },
              "interval_semitones": { "type": ["number", "null"] },
              "velocity": { "type": "number", "minimum": 0, "maximum": 1 },
              "timing_offset_ms": { "type": "number" },
              "tags": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "transformations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "start_seconds", "end_seconds", "claim"],
        "properties": {
          "source_id": { "type": "string" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "claim": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "alternatives": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}

